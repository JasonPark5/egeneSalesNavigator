# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 커밋하지 마세요)

PORT=4000

# ---------------------------------------------------------------------------
# BACKEND_MODE
#   mock       -> ActionFlow 없이, 이 서버가 직접 LLM+카카오 검색을 수행합니다.
#                 (ActionFlow 플로우가 아직 준비되지 않았을 때 프론트엔드 데모/개발용)
#   actionflow -> 사내 ActionFlow에 실행을 위임하고, 완료될 때까지 폴링합니다.
# ---------------------------------------------------------------------------
BACKEND_MODE=mock

# ============================================================================
# ActionFlow 연동 설정 (BACKEND_MODE=actionflow 일 때 사용)
# 실제 값은 ActionFlow 관리 화면 / 사내 문서에서 확인해 채워주세요.
# ============================================================================

# ActionFlow API 베이스 URL
ACTIONFLOW_BASE_URL=https://actionflow.internal.example.com

# 인증 방식은 사내 ActionFlow 스펙에 맞춰 actionflowClient.js에서 조정하세요.
# 기본 구현은 Authorization: Bearer <token> 헤더를 붙입니다.
ACTIONFLOW_API_KEY=

# 실행할 플로우 ID (ActionFlow에서 만든 "음성 길찾기" 플로우의 ID)
ACTIONFLOW_FLOW_ID=

# 실행 트리거 경로. {flowId} 는 ACTIONFLOW_FLOW_ID로 치환됩니다.
ACTIONFLOW_TRIGGER_PATH=/api/v1/flows/{flowId}/runs

# 실행 상태 조회 경로. {runId} 는 트리거 응답에서 얻은 실행 ID로 치환됩니다.
ACTIONFLOW_STATUS_PATH=/api/v1/runs/{runId}

# 트리거 응답에서 실행 ID를 꺼낼 필드 경로 (점 표기법, 예: data.id)
ACTIONFLOW_RUN_ID_FIELD=runId

# 상태 응답에서 진행 상태를 꺼낼 필드 경로
ACTIONFLOW_STATUS_FIELD=status

# 완료/실패로 간주할 상태 값 (콤마 구분)
ACTIONFLOW_DONE_VALUES=completed,success,done
ACTIONFLOW_ERROR_VALUES=failed,error

# 상태 응답에서 최종 결과(JSON)를 꺼낼 필드 경로
ACTIONFLOW_RESULT_FIELD=result

# 폴링 주기 / 최대 대기 시간 (ms)
ACTIONFLOW_POLL_INTERVAL_MS=1500
ACTIONFLOW_POLL_TIMEOUT_MS=30000

# ============================================================================
# mock 모드 설정 (BACKEND_MODE=mock 일 때 사용) - 기존 n8n 워크플로우와 동일 로직
# ============================================================================

# gemini | claude
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 카카오 로컬 검색 (developers.kakao.com)
KAKAO_REST_API_KEY=
