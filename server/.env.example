# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 커밋하지 마세요)

PORT=4000

# ---------------------------------------------------------------------------
# BACKEND_MODE
#   mock       -> ActionFlow 없이, 이 서버가 직접 LLM+카카오 검색을 수행합니다.
#                 (ActionFlow 플로우가 아직 준비되지 않았을 때 프론트엔드 데모/개발용)
#   actionflow -> 사내 ActionFlow의 API Trigger를 호출하고 응답을 그대로 반환합니다.
# ---------------------------------------------------------------------------
BACKEND_MODE=mock

# ============================================================================
# ActionFlow 연동 설정 (BACKEND_MODE=actionflow 일 때 사용)
# ActionFlow에서 만든 플로우의 API Trigger 노드는 POST + JSON body를 받고,
# 플로우 끝(Json Result 노드)에서 만든 JSON을 동기로 그대로 응답합니다.
# ============================================================================

# API Trigger의 URI 전체 (ActionFlow 화면에서 "복사" 버튼으로 확인)
# 예: https://actionflow.internal.example.com/api/egene/actionflow/api/AF_XXXXXX
ACTIONFLOW_API_URL=

# 필요하면 Authorization: Bearer <token> 헤더로 붙습니다. 인증이 없으면 비워두세요.
ACTIONFLOW_API_KEY=

# ============================================================================
# mock 모드 설정 (BACKEND_MODE=mock 일 때 사용) - 기존 n8n 워크플로우와 동일 로직
# ============================================================================

# gemini | claude | openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 해커톤에서 제공되는 OpenAI 키 (ActionFlow의 Plugin/Agent 노드와 동일 계열)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 카카오 로컬 검색 (developers.kakao.com)
KAKAO_REST_API_KEY=

# 오늘 일정 자동차 이동시간 (NAVER Cloud Platform Maps > Directions 5, 월 60,000건 무료)
# 브라우저에서 직접 호출하면 CORS로 막혀서(NCP 포럼에도 동일 리포트 있음, 실제 확인함)
# 서버를 통해서만 호출합니다. 비워두면 자동으로 직선거리 기반 추정치로 대체됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
