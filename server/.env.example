# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 커밋하지 마세요)

PORT=4000

# ---------------------------------------------------------------------------
# BACKEND_MODE
#   mock       -> ActionFlow 없이, 이 서버가 직접 LLM+카카오 검색을 수행합니다.
#                 (ActionFlow 플로우가 아직 준비되지 않았을 때 프론트엔드 데모/개발용)
#   actionflow -> 사내 ActionFlow의 API Trigger를 호출하고 응답을 그대로 반환합니다.
# ---------------------------------------------------------------------------
BACKEND_MODE=mock

# ============================================================================
# ActionFlow 연동 설정 (BACKEND_MODE=actionflow 일 때 사용)
# ActionFlow에서 만든 각 플로우의 API Trigger 노드는 POST + JSON body를 받고,
# 플로우 끝(Json Result 노드)에서 만든 JSON을 동기로 그대로 응답합니다.
# 요청 종류(inputType)별로 플로우가 나뉘어 있습니다 — 각 플로우가 받는 요청/돌려줘야
# 하는 응답 형태는 README의 "ActionFlow 플로우 계약" 표를 참고하세요.
# ============================================================================

# 장소 검색 (inputType: text/chip/locate 공통) — Kakao 검색 + 필요시 LLM 의도분석/큐레이션
ACTIONFLOW_SEARCH_URL=

# 오늘 일정 브리핑 문장 생성 (inputType: briefing) — LLM만 사용
ACTIONFLOW_BRIEFING_URL=

# 음성 발화 -> 캘린더 일정 생성 정보 추출 (inputType: create-event) — LLM만 사용
ACTIONFLOW_CREATE_EVENT_URL=

# 실시간 자동차 이동시간 (inputType: travel-time) — Naver Directions만 사용, LLM 없음
ACTIONFLOW_TRAVEL_TIME_URL=

# 필요하면 4개 플로우 모두에 Authorization: Bearer <token> 헤더로 붙습니다. 인증이 없으면 비워두세요.
ACTIONFLOW_API_KEY=

# [임시 디버깅용] 사내 게이트웨이가 브라우저 세션(쿠키/CSRF 토큰) 없는 요청을 막는 경우,
# 정확한 헤더 이름을 몰라도 빠르게 실험해볼 수 있게 임의 헤더를 JSON으로 넣는다.
# 예: {"X-CSRF-Token":"...","Cookie":"JSESSIONID=..."}
# 주의: 세션에 묶인 값이라 곧 만료됨 — 확인용일 뿐, 진짜 해결책은 IT/ActionFlow 쪽에
# 서버 대 서버 인증 방법을 물어보는 것. 다 확인했으면 지우세요.
ACTIONFLOW_EXTRA_HEADERS=

# ============================================================================
# mock 모드 설정 (BACKEND_MODE=mock 일 때 사용) - 기존 n8n 워크플로우와 동일 로직
# ============================================================================

# gemini | claude | openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 해커톤에서 제공되는 OpenAI 키 (ActionFlow의 Plugin/Agent 노드와 동일 계열)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 카카오 로컬 검색 (developers.kakao.com)
KAKAO_REST_API_KEY=

# 오늘 일정 자동차 이동시간 (NAVER Cloud Platform Maps > Directions 5, 월 60,000건 무료)
# 브라우저에서 직접 호출하면 CORS로 막혀서(NCP 포럼에도 동일 리포트 있음, 실제 확인함)
# 서버를 통해서만 호출합니다. 비워두면 자동으로 직선거리 기반 추정치로 대체됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================================================
# Google Calendar OAuth (BACKEND_MODE와 무관하게 항상 필요 — 캘린더 연동은 ActionFlow가
# 아니라 이 서버가 직접 Google과 주고받는 표준 OAuth 흐름)
# ============================================================================

# Google Cloud Console에서 발급한 OAuth 클라이언트의 "클라이언트 보안 비밀번호".
# 클라이언트 ID는 비밀값이 아니라 server/src/index.js에 하드코딩되어 있음(worker/와 동일 값).
# 승인된 리디렉션 URI에 http://localhost:<PORT>/api/auth/google/callback을 등록해야 합니다.
GOOGLE_CLIENT_SECRET=
